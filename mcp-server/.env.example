# Owner key: required. The operator's secret for approving OAuth authorizations.
# At Claude.ai's authorize step, the user enters this once and Claude.ai
# receives its own access + refresh tokens. Treat this like a master password.
WLM_MCP_OWNER_KEY=replace-with-a-long-random-secret

# Public issuer / resource URL. Must be reachable from clients (Claude.ai).
# - Local-only:    http://127.0.0.1:8765
# - Cloudflare:    https://blackreach.dhanjit.me
WLM_MCP_PUBLIC_URL=http://127.0.0.1:8765

# Bind address. Use 0.0.0.0 if a Docker-based cloudflared reaches us via
# host.docker.internal.
# WLM_MCP_HOST=127.0.0.1
# WLM_MCP_PORT=8765

# Public hostnames allowed on the Host header (comma-separated).
# 127.0.0.1, localhost, host.docker.internal are always allowed.
# WLM_MCP_ALLOWED_HOSTS=blackreach.dhanjit.me
